# Optional. Prefer `leo model login <provider>`, which stores keys in your OS
# keychain instead of a plaintext file. These env vars still take precedence
# when set, which is useful for CI.

# OPENROUTER_API_KEY=sk-or-your-key-here
# GROQ_API_KEY=gsk_your-key-here
# HF_API_KEY=hf_your-token-here

# Override the chat chain with a single provider for one run:
# LEO_CHAT_PROVIDER=ollama
# LEO_CHAT_MODEL=qwen3:8b
